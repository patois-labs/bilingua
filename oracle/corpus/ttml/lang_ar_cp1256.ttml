<?xml version="1.0" encoding="windows-1256"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="ar">
  <head><metadata><ttm:title>Bakery ar</ttm:title></metadata><styling><style xml:id="s1" tts:color="white"/></styling></head>
  <body><div>
    <p begin="1s" end="3s" style="s1">مرحبا بكم في المخبز</p>
    <p begin="4s" end="6s" style="s1"><span tts:fontWeight="bold">لديك {0} طلبات لـ {1}</span></p>
    <p begin="7s" end="9s" style="s1">خبز طازج<br/>كل صباح</p>
    <p begin="10s" end="12s" style="s1">اضغط %1$s للمتابعة</p>
    <p begin="13s" end="15s" style="s1">شكرا &amp; وداعا</p>
  </div></body>
</tt>
