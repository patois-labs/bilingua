<Window x:Class="App.Main" Title="Main window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Window.Resources>
    <sys:String x:Key="Ok">OK</sys:String>
  </Window.Resources>
  <StackPanel>
    <Button Content="Click me" ToolTip='Saves "all"' Name="SaveButton"/>
    <TextBlock Text="{Binding Status}"/>
    <TextBlock Text="{}{0} files"/>
    <TextBlock Text="{StaticResource Ok}" Tag="Not translated"/>
    <HeaderedContentControl Header="Settings" Content="42"/>
    <Button.Content>Ignored property element</Button.Content>
  </StackPanel>
</Window>
