<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="tr">
  <head><metadata><ttm:title>Bakery tr</ttm:title></metadata><styling><style xml:id="s1" tts:color="white"/></styling></head>
  <body><div>
    <p begin="1s" end="3s" style="s1">Fırına hoş geldiniz</p>
    <p begin="4s" end="6s" style="s1"><span tts:fontWeight="bold">{1} için {0} siparişiniz var</span></p>
    <p begin="7s" end="9s" style="s1">Taze ekmek<br/>her sabah</p>
    <p begin="10s" end="12s" style="s1">Devam etmek için %1$s tuşuna basın</p>
    <p begin="13s" end="15s" style="s1">Teşekkürler &amp; hoşça kalın</p>
  </div></body>
</tt>
