<?xml version="1.0" encoding="EUC-JP"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="ja">
  <head><metadata><ttm:title>Bakery ja</ttm:title></metadata><styling><style xml:id="s1" tts:color="white"/></styling></head>
  <body><div>
    <p begin="1s" end="3s" style="s1">パン屋へようこそ</p>
    <p begin="4s" end="6s" style="s1"><span tts:fontWeight="bold">{1}のご注文が{0}件あります</span></p>
    <p begin="7s" end="9s" style="s1">焼きたてのパン<br/>毎朝</p>
    <p begin="10s" end="12s" style="s1">続けるには%1$sを押してください</p>
    <p begin="13s" end="15s" style="s1">ありがとう &amp; さようなら</p>
  </div></body>
</tt>
