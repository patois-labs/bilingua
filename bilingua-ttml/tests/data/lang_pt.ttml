<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="pt">
  <head><metadata><ttm:title>Bakery pt</ttm:title></metadata><styling><style xml:id="s1" tts:color="white"/></styling></head>
  <body><div>
    <p begin="1s" end="3s" style="s1">Bem-vindo à padaria</p>
    <p begin="4s" end="6s" style="s1"><span tts:fontWeight="bold">Você tem {0} pedidos para {1}</span></p>
    <p begin="7s" end="9s" style="s1">Pão fresco<br/>todas as manhãs</p>
    <p begin="10s" end="12s" style="s1">Pressione %1$s para continuar</p>
    <p begin="13s" end="15s" style="s1">Obrigado &amp; até logo</p>
  </div></body>
</tt>
