<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="es">
  <head><metadata><ttm:title>Bakery es</ttm:title></metadata><styling><style xml:id="s1" tts:color="white"/></styling></head>
  <body><div>
    <p begin="1s" end="3s" style="s1">Bienvenido a la panadería</p>
    <p begin="4s" end="6s" style="s1"><span tts:fontWeight="bold">Tiene {0} pedidos para {1}</span></p>
    <p begin="7s" end="9s" style="s1">Pan fresco<br/>todas las mañanas</p>
    <p begin="10s" end="12s" style="s1">Pulse %1$s para continuar</p>
    <p begin="13s" end="15s" style="s1">Gracias &amp; adiós</p>
  </div></body>
</tt>
