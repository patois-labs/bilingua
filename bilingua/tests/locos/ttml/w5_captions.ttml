<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <head>
    <styling><style xml:id="s1" tts:color="white"/><style xml:id="s2" tts:fontStyle="italic"/></styling>
  </head>
  <body style="s1">
    <div>
      <p begin="00:00:01.000" end="00:00:02.000" style="s2">First line<br/>second line</p>
      <p begin="00:00:02.000" end="00:00:03.000"></p>
      <p begin="00:00:03.000" end="00:00:04.000"/>
      <p begin="00:00:04.000" end="00:00:05.000" style="s1">Fish &amp; chips <set begin="1s" tts:color="red"/>now</p>
      <p begin="00:00:05.000" end="00:00:06.000">  <span tts:color="yellow">Bold</span> move &#169; 2026  </p>
      <p begin="00:00:06.000" end="00:00:07.000">Last one</p>
    </div>
  </body>
</tt>
