<ut Type="start" Style="external" RightEdge="angle" DisplayText="p">&lt;p&gt;</ut><Tu MatchPercent="0"><Tuv Lang="DE-DE">Willkommen zurück, bitte anmelden.</Tuv><Tuv Lang="EN-US"></Tuv></Tu><ut Type="end" Style="external" LeftEdge="angle" DisplayText="p">&lt;/p&gt;</ut>
<ut Type="start" Style="external" RightEdge="angle" DisplayText="p">&lt;p&gt;</ut><Tu MatchPercent="0"><Tuv Lang="DE-DE">Klicken Sie auf <ut Type="start" RightEdge="angle" DisplayText="b">&lt;b&gt;</ut>Speichern<ut Type="end" LeftEdge="angle" DisplayText="b">&lt;/b&gt;</ut> um Ihre Notizen zu behalten.</Tuv></Tu><ut Type="end" Style="external" LeftEdge="angle" DisplayText="p">&lt;/p&gt;</ut>
<ut Type="start" Style="external" RightEdge="angle" DisplayText="li">&lt;li&gt;</ut><Tu MatchPercent="0"><Tuv Lang="DE-DE">Gesamtsumme:<ut DisplayText="br">&lt;br&gt;</ut><df Bold="on">Danke für Ihre Bestellung.</df> </Tuv><Tuv Lang="EN-US"/></Tu><ut Type="end" Style="external" LeftEdge="angle" DisplayText="li">&lt;/li&gt;</ut>
<ut Type="start" Style="external" RightEdge="angle" DisplayText="h2">&lt;h2&gt;</ut>Einstellungen<ut Type="end" Style="external" LeftEdge="angle" DisplayText="h2">&lt;/h2&gt;</ut>
<ut Type="start" Style="external" RightEdge="angle" DisplayText="p">&lt;p&gt;</ut><Tu MatchPercent="100" Origin="manual"><Tuv Lang="DE-DE">Schon übersetzte Zeile.</Tuv><Tuv Lang="EN-US">Done &amp; dusted.</Tuv></Tu><ut Type="end" Style="external" LeftEdge="angle" DisplayText="p">&lt;/p&gt;</ut>
</Raw></Body></TRADOStag>
