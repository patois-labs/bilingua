<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE translationbundle>
<translationbundle lang="fr">
  <translation id="greet.en">FR Welcome back, <ph name="USER"/>! You have <ph name="START_BOLD"/>3 new messages<ph name="CLOSE_BOLD"/>.</translation>
  <translation id="greet.fr">FR Bon retour, <ph name="USER"/> ! Vous avez <ph name="START_BOLD"/>3 nouveaux messages<ph name="CLOSE_BOLD"/>.</translation>
  <translation id="greet.de">FR Willkommen zurück, <ph name="USER"/>! Grüße aus München &amp; Zürich.</translation>
  <translation id="greet.es">FR ¿Cómo estás, <ph name="USER"/>? ¡Mañana habrá niños!</translation>
  <translation id="greet.ru">FR Добро пожаловать, <ph name="USER"/>! У вас 3 новых сообщения.</translation>
  <translation id="greet.ar">FR مرحباً بعودتك، <ph name="USER"/>! لديك 3 رسائل جديدة.</translation>
  <translation id="greet.ja">FR お帰りなさい、<ph name="USER"/>さん！新しいメッセージが3件あります。</translation>
  <translation id="greet.zh">FR 欢迎回来，<ph name="USER"/>！您有 3 条新消息。</translation>
  <translation id="greet.ko">FR 다시 오신 것을 환영합니다, <ph name="USER"/>님! 새 메시지가 3개 있습니다.</translation>
  <translation id="greet.tr">FR Tekrar hoş geldiniz, <ph name="USER"/>! Üç yeni iletiniz var.</translation>
  <translation id="greet.hi">FR वापस स्वागत है, <ph name="USER"/>! आपके 3 नए संदेश हैं।</translation>
</translationbundle>
